    "express-rate-limit": "^7.1.5",
    "openai": "^4.20.1",
    "axios": "^1.6.2",
    "uuid": "^9.0.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "express-validator": "^7.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
